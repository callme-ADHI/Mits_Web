generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgType {
  club
  department
}

enum EventStatus {
  upcoming
  past
}

model Organization {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  type                OrgType
  logoUrl             String?
  primaryColor        String   @default("#E10600")
  secondaryColor      String   @default("#111111")
  description         String?
  contactEmail        String?
  showFacultyContact  Boolean  @default(true)
  facultyContactEmail String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  logoData            Bytes?
  logoMime            String?
  logoUpdatedAt       DateTime?

  users           User[]
  events          Event[]
  achievements    Achievement[]
  activityLogs    ActivityLog[]
  contactMessages ContactMessage[]
}

model User {
  id             String       @id @default(cuid())
  name           String
  email          String       @unique
  passwordHash   String
  role           String       @default("org_admin")
  isSuperAdmin   Boolean      @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())

  activityLogs ActivityLog[]
}

model Event {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  title          String
  description    String?
  eventDate      DateTime
  status         EventStatus  @default(upcoming)
  imageUrl       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Achievement {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  title           String
  description     String?
  achievementDate DateTime
  imageUrl        String?
  createdAt       DateTime     @default(now())

  @@index([organizationId])
}

model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  action         String
  details        String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model ContactMessage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String
  message        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model SuperAdmin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
